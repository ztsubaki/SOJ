# Server-only Web BFF configuration for local development.
PLATFORM_NAME=SOJ
GRPC_ADDR=localhost:50051
GRPC_INSECURE_DEV=true
WEB_BFF_SERVICE_TOKEN=dev-web-bff-token-change-me
CONTROL_PLANE_HTTP_URL=http://localhost:8080
# Only for local HTTP testing. Production uses HTTPS and must keep this unset.
# SESSION_COOKIE_SECURE=false
# Production: omit GRPC_INSECURE_DEV and configure a trusted CA if the
# Control Plane certificate is not issued by the host trust store.
# GRPC_TLS_CA_FILE=/run/secrets/control-plane-ca.pem
# GRPC_TLS_SERVER_NAME=control-plane.internal
