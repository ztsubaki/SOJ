# Copy this file to .env at the repository root, replace every dev secret,
# then load it before starting Control Plane:
#   set -a; source .env; set +a; make api

# PostgreSQL is owned exclusively by Control Plane.
DATABASE_URL=postgres://soj:soj@localhost:5432/soj?sslmode=disable

# Control Plane listeners. GRPC_INSECURE_DEV is loopback-only.
HTTP_ADDR=localhost:8080
GRPC_ADDR=localhost:50051
# Local development only. Production must omit this or set it to false and
# provide GRPC_TLS_CERT_FILE plus GRPC_TLS_KEY_FILE.
GRPC_INSECURE_DEV=true
# Production requires TLS instead:
# GRPC_INSECURE_DEV=false
# GRPC_TLS_CERT_FILE=/run/secrets/control-plane/tls.crt
# GRPC_TLS_KEY_FILE=/run/secrets/control-plane/tls.key

# Service-to-service credentials. Replace every value outside local development.
AGENT_SERVICE_TOKEN=dev-agent-token-change-me
WEB_BFF_SERVICE_TOKEN=dev-web-bff-token-change-me
ADMIN_BFF_SERVICE_TOKEN=dev-admin-bff-token-change-me

# Optional comma-separated registration email-domain allowlist. Leave unset to
# accept any syntactically valid email address.
# REGISTRATION_EMAIL_DOMAINS=example.edu,students.example.edu
