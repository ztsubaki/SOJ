# Copy to judge.toml, set the token and paths, then run:
#   soj-judge /etc/soj/judge.toml

# Default backend when omitted. Docker uses judge.docker.toml.example instead.
agent_executor = "slurm"

# Optional. A UUID is generated at each Agent startup if omitted.
# agent_session_id = "11111111-1111-4111-8111-111111111111"
agent_partition = "judge"
agent_service_token = "replace-with-agent-service-token"
judge_work_root = "/var/lib/soj-judge/work"
judge_idle_poll_ms = 1000

# gRPC remains TLS. The CA must validate the Control Plane server certificate.
grpc_addr = "control-plane.internal:50051"
grpc_ca_file = "/etc/soj/control-plane-ca.pem"
# Set this when grpc_addr is an IP but the server certificate uses a DNS name.
# grpc_server_name = "control-plane.internal"

# Artifact data-plane endpoint. HTTP is accepted but prints a warning at startup.
control_plane_http_url = "https://control-plane.internal:8080"

# Local loopback development only; omit in deployment.
# grpc_insecure_dev = true
